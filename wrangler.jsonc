{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "distinct-hardwood-migration",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "distinct-hardwood-migration-leads",
      "migrations_dir": "drizzle"
    }
  ],
  "triggers": {
    "crons": [
      "17 9 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
